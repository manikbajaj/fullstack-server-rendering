// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  /**
   * AVAILABLE OPERATING SYSTEMS
   * https://www.prisma.io/docs/orm/reference/prisma-schema-reference#binarytargets-options
   */
  binaryTargets = ["native", "darwin-arm64", "linux-arm64-openssl-3.0.x", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String? // Optional field
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) // Sets the default value to the current datetime
  updatedAt DateTime @updatedAt // Updates the field every time the record is updated
  Post      Post[]
}

model Post {
  id               Int      @id @default(autoincrement())
  title            String
  content          String   @db.Text // Suitable for storing long-form content
  slug             String   @unique
  excerpt          String
  featuredImageUrl String?  @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  author   User  @relation(fields: [authorId], references: [id])
  authorId Int // This assumes that each post is linked to a User
  /**
   * [authorId]: Tells Prisma that the authorId field in the Post model is used to establish this relationship. It is where the foreign key value (user's ID) is stored.
   */
  tags     Tag[]
}

/**
 * author: This is the field name in the Post model representing the related User. It is how you will access the post's author from the post object in your application (e.g., post.author).
 * User: This indicates the type of the relation, which is the User model. It specifies that the author field is linked to an instance of the User model.
 * @relation: This is a Prisma directive used to specify details about the relationship between models.
 * fields: [authorId]: This part of the @relation directive tells Prisma which field in the Post model is used to store the foreign key. In this case, authorId is a field in the Post model that will hold the ID of the User who is the author of the post.
 * references: [id]: This specifies that the authorId field in the Post model corresponds to the id field in the User model. In other words, authorId is a foreign key that references the primary key (id) of the User model.
 */

/**
 * Tag and Post model have an implicit may to m,any relationship
 * Implicit m-n relations define relation fields as lists on both sides of the relation. Although the relation table exists in the underlying database, it is managed by Prisma ORM and does not manifest in the Prisma schema. Implicit relation tables follow a specific convention.
 * https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/many-to-many-relations#implicit-many-to-many-relations
 */

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
