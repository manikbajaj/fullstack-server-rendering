<div class="row mb-5">
  <div
    class="col col-lg-8 offset-lg-2 text-center blog-detail-hero-img-container"
  >
    <img class="" src="{{featuredImageUrl}}" />
  </div>
</div>

<div class="row mb-5">
  <div class="col d-flex justify-content-center">
      {{> avatar}}
  </div>
</div>

<div class="row ">
  <div class="col col-lg-10 offset-1 text-center">
    <h1 class="h3 text-dark text-opacity-75">
      {{title}}
    </h1>
    <p class="text-light-emphasis fst-italic mb-5">
      {{excerpt}}
    </p>
  </div>
</div>

<div class="row mb-5">
  <div class="col text-center">
    {{content}}
  </div>
</div>

<div class="row">
  <div class="col col-lg-6 offset-lg-3">
      {{> tags}}
  </div>
</div>