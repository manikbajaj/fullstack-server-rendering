<div>
  <div class="row">
    <div class="col-12 col-md-8">
      <div class="row">
        <div class="col">
          <h1 class="h3 text-dark text-opacity-75">
            Create New Post
          </h1>
        </div>
      </div>

      <div class="row mt-4">
        <div class="col-12">
          <form id="createPost">
            <div class="mb-3">
              <input
                type="text"
                class="form-control"
                id="title"
                placeholder="Title"
                name="title"
              />
            </div>
            <div class="mb-3">
              <input
                type="text"
                class="form-control"
                id="slug"
                placeholder="slug (example-url)"
                name="slug"
              />
            </div>
            <div class="mb-3">
              <textarea
                class="form-control"
                id="excerpt"
                rows="3"
                placeholder="Excerpt"
                name="excerpt"
              ></textarea>
            </div>

            <div class="mb-3">
              <h6>Tags</h6>
              <div class="form-check form-check-inline">
                <input
                  class="form-check-input"
                  type="checkbox"
                  id="inlineCheckbox1"
                  value="camping"
                />
                <label
                  class="form-check-label"
                  for="inlineCheckbox1"
                >camping</label>
              </div>
              <div class="form-check form-check-inline">
                <input
                  class="form-check-input"
                  type="checkbox"
                  id="inlineCheckbox2"
                  value="mountains"
                />
                <label
                  class="form-check-label"
                  for="inlineCheckbox2"
                >mountains</label>
              </div>
            </div>

            <div style="height: 400px; margin-bottom:60px;">
              <div id="editor" class="quill-editor">
              </div>
            </div>
            <input
              type="hidden"
              id="featuredImageUrl"
              name="featuredImageUrl"
            />
            <button type="submit" class="btn btn-primary">Create a Post</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-12 col-md-4">
      <div class="row">
        <div class="col-12 mb-3">
          <h5 class="h5 text-dark text-opacity-75">
            Upload Featured Image
          </h5>
        </div>
        <div class="col-12 mb-3">
          <div class="card" style="w-100" id="imageContainer">
            <img
              src="/images/image-preview.png"
              class="card-img"
              alt="Featured image preview"
              id="previewImage"
            />
          </div>
        </div>
        <div class="col-12">
          <form
            id="uploadForm"
            hx-encoding="multipart/form-data"
            hx-post="/upload"
            hx-target="#previewImage"
            hx-swap="outerHTML"
          >
            <div class="mb-3 d-flex flex-row column-gap-3">
              <input
                class="form-control"
                type="file"
                id="featuredImage"
                name="featuredImage"
                accept=".png, .jpg, .jpeg"
              />
              <button class="btn btn-sm btn-secondary">
                Upload
              </button>
            </div>
            <progress
              class="w-100"
              id="progress"
              value="0"
              max="100"
            ></progress>
          </form>
        </div>
      </div>
    </div>
  </div>

</div>