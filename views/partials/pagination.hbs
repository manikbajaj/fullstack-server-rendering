<nav aria-label="Page navigation example">
  <ul class="pagination">
    <li class="page-item">
      <a
        class="page-link"
        href="{{pagination.previousPage}}"
        aria-label="Previous"
      >
        <span aria-hidden="true">&laquo;</span>
      </a>
    </li>
    {{#each pagination.pageLinks}}
      <li class="page-item"><a
          class="page-link {{#if this.activePage}}active{{/if}}"
          href="{{this.link}}"
        >{{this.pageNumber}}</a></li>
    {{/each}}
    <li class="page-item">
      <a class="page-link" href="{{pagination.nextPage}}" aria-label="Next">
        <span aria-hidden="true">&raquo;</span>
      </a>
    </li>
  </ul>
</nav>