<div class="d-flex flex-column text-center justify-content-center">
  <h5 class="text-dark text-opacity-75">Tags</h5>

  <div
    class="my-2 d-flex flex-row column-gap-2 row-gap-2 justify-content-center flex-wrap"
  >
    {{#each tags}}
      <a
        href="{{this.link}}"
        class="btn btn-outline-secondary btn-sm"
      >{{this.name}}</a>
    {{/each}}
  </div>
</div>