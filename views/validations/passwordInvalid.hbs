<div class="mb-3" hx-target="this" hx-swap="outerHTML">
  <input
    type="password"
    class="form-control is-invalid"
    id="password"
    placeholder="password"
    name="password"
    hx-post="/validations/password"
    hx-trigger="change"
    value="{{value}}"
    required
  />
  <div class="invalid-feedback">
    The password must be of 8 chars, with atleas 1 uppercase and 1 lowercase
    char, 1 number and 1 symbol.
  </div>
</div>