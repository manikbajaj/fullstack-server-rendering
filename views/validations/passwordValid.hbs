<div class="mb-3" hx-target="this" hx-swap="outerHTML">
  <input
    type="password"
    class="form-control is-valid"
    id="password"
    placeholder="password"
    name="password"
    hx-post="/validations/password"
    hx-trigger="change"
    value="{{value}}"
  />
  <div class="valid-feedback">
    Looks good!
  </div>
</div>