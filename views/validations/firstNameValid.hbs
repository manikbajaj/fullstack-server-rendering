<div class="mb-3" hx-target="this" hx-swap="outerHTML">
  <input
    type="text"
    class="form-control is-valid"
    id="firstName"
    placeholder="First Name"
    name="firstName"
    hx-trigger="change"
    hx-post="/validations/firstName"
    value="{{value}}"
    required
  />
  <div class="valid-feedback">
    Looks good!
  </div>
</div>