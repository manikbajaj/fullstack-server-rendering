<div class="mb-3" hx-target="this" hx-swap="outerHTML">
  <input
    type="email"
    class="form-control is-invalid"
    id="email"
    placeholder="Email"
    aria-describedby="emailHelp"
    name="email"
    hx-post="/validations/email"
    hx-trigger="change"
    value="{{value}}"
  />
  <div class="invalid-feedback">
    Please use a valid email address
  </div>
</div>