<div class="row">
  <div class="col text-center">
    <h1 class="h3 text-dark text-opacity-75">
      Login
    </h1>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-6 offset-md-3">
    <form action="http://localhost:3000/login" method="post">
      <div class="mb-3">
        {{! https://htmx.org/docs/#triggers }}
        <input
          type="email"
          class="form-control"
          id="email"
          placeholder="Email"
          aria-describedby="emailHelp"
          name="email"
          hx-post="/validations/email"
          hx-trigger="change"
        />
      </div>
      <div class="mb-3">
        <input
          type="password"
          class="form-control"
          id="password"
          placeholder="password"
          name="password"
          hx-post="/validations/password"
          hx-trigger="change"
        />
      </div>

      <button type="submit" class="btn btn-primary">Login</button>
    </form>
  </div>
</div>