{{! https://getbootstrap.com/docs/5.3/components/alerts/#additional-content }}
{{#if signupSuccess}}
  <div class="row mb-3">
    <div class="col-md-8 offset-md-2">
      <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">Yay! Welcome To Wanderlust</h4>
        <p>Your new account is all setup. You can login and start creating
          posts.</p>
      </div>
    </div>
  </div>
{{/if}}

<div class="row">
  <div class="col text-center">
    <h1 class="h3 text-dark text-opacity-75">
      Login
    </h1>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-6 offset-md-3">
    <form hx-post="/login">
      <div class="mb-3" hx-target="this" hx-swap="outerHTML">
        {{! https://htmx.org/docs/#triggers }}
        <input
          type="email"
          class="form-control"
          id="email"
          placeholder="Email"
          aria-describedby="emailHelp"
          name="email"
          hx-trigger="change"
          hx-post="/validations/email"
        />
      </div>
      <div class="mb-3" hx-target="this" hx-swap="outerHTML">
        <input
          type="password"
          class="form-control"
          id="password"
          placeholder="password"
          name="password"
          hx-post="/validations/password"
          hx-trigger="change"
          required
        />
      </div>
      <button type="submit" class="btn btn-primary">Login</button>
    </form>
  </div>
</div>