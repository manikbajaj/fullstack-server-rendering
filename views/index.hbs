<div class="row">
  <section class="col-12 col-md-8">
    <div>
      <h1 class="h3 text-dark text-opacity-75">
        Explore the Wild: Adventures in Uncharted Land
      </h1>
      <p class="text-light-emphasis fst-italic mb-5">
        Latest Journeys and Wilderness Discoveries
      </p>
    </div>
    <div>
      {{#if posts}}
        {{#each posts}}
          {{> blogPost title=this.title excerpt=this.excerpt updatedAt=this.updatedAt featuredImageUrl=this.featuredImageUrl slug=this.slug id=this.id }}
        {{/each}}
      {{ else }}
      <h5>There are currently no posts to display.</h5>
      {{/if}}
      
    </div>
    <div class="d-flex justify-content-end">
      {{#if pagination.pageLinks}}
        {{> pagination}}
      {{/if}}
    </div>
  </section>
  <aside class="col-12 col-md-4 text-center pt-md-0 pt-4">
    {{> tags}}
  </aside>
</div>
